+                  void handleToggleStatus(selectedClient.id)
+                }
+              >
+                {selectedClient.active ? "Desativar" : "Ativar"}
+              </Button>
+
+              <Button
+                size="compact"
+                variant="danger"
+                fullWidth
+                leadingIcon={<Trash2 />}
+                onClick={() =>
+                  void handleDelete(selectedClient.id)
+                }
+              >
+                Excluir
+              </Button>
+            </div>
+          </>
+        ) : null}
+      </AnimatedModal>
+
+      <AnimatedModal
+        open={isFormModalOpen}
+        onClose={closeFormModal}
