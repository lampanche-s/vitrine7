-
-        return new ReceiptPaymentResponse(
-                payment.paymentId(),
-                payment.method(),
-                payment.processingMode(),
-                payment.status(),
-                payment.approvedAmountCents(),
-                payment.approvedAt()
-                        .atZoneSameInstant(timeZone())
