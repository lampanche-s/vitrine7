#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly RELEASE_ROOT="/home/vitrine7-deploy/releases"
readonly BACKUP_ROOT="/opt/vitrine7/backups"
readonly BACKEND_JAR="/opt/vitrine7/backend/vitrine7-backend.jar"
readonly FRONTEND_DIR="/opt/vitrine7/frontend"
readonly ENV_FILE="/etc/vitrine7/application.env"
readonly STATE_ROOT="/var/lib/vitrine7-deploy"
readonly ACTIVE_RELEASE_FILE="${STATE_ROOT}/current-release"
readonly LEDGER_FILE="${STATE_ROOT}/deployments.jsonl"
readonly LOCK_FILE="/run/lock/vitrine7-deploy.lock"
readonly SERVICE="vitrine7-backend.service"
readonly BACKEND_HEALTH="http://127.0.0.1:8081/actuator/health"
readonly AGENTS_HEALTH="http://127.0.0.1:8081/api/v1/operations/agents/status"
readonly PUBLIC_SITE="https://vitrine7sys.duckdns.org"
readonly COMMAND_TIMEOUT="${VITRINE7_DEPLOY_TIMEOUT:-120}"

log() { printf '%s\n' "$*"; }
die() { printf 'ERRO: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'USAGE'
Uso:
  vitrine7-deploy status
  vitrine7-deploy preflight <release>
  vitrine7-deploy deploy <release>
  vitrine7-deploy rollback-artifacts <backup>
  vitrine7-deploy releases [--prune --confirm=DELETE-OLD-RELEASES]
  vitrine7-deploy adopt-current-release <release>
  vitrine7-deploy rotate-report-credential
  vitrine7-deploy agents-status [--strict]

rollback-artifacts nunca restaura banco. releases sem --prune e somente leitura.
USAGE
}

require_root() {
    [[ ${EUID} -eq 0 ]] || die "este comando exige root via sudo autorizado"
}

require_commands() {
    local command_name
    for command_name in "$@"; do
        command -v "$command_name" >/dev/null 2>&1 \
            || die "comando obrigatorio ausente: ${command_name}"
    done
}

acquire_lock() {
    require_commands flock
    install -d -m 0755 "${LOCK_FILE%/*}"
    exec 9>"${LOCK_FILE}"
    flock -n 9 || die "outra operacao do wrapper esta em andamento"
}

validate_name() {
    local value="$1"
    [[ ${value} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]] \
        || die "nome invalido: ${value}"
    [[ ${value} != "." && ${value} != ".." ]] || die "nome reservado"
}

assert_no_symlink_path() {
    local target="$1"
    local current="/"
    local component
    IFS='/' read -r -a components <<< "${target#/}"
    for component in "${components[@]}"; do
        [[ -n ${component} ]] || continue
        current="${current%/}/${component}"
        [[ ! -L ${current} ]] || die "symlink recusado: ${current}"
    done
}

validated_child() {
    local root="$1"
    local name="$2"
    local expected
    local actual
    validate_name "${name}"
    assert_no_symlink_path "${root}"
    expected="${root}/${name}"
    assert_no_symlink_path "${expected}"
    [[ -d ${expected} ]] || die "diretorio inexistente: ${expected}"
    actual="$(realpath -e -- "${expected}")"
    [[ ${actual} == "${expected}" ]] || die "caminho fora da raiz autorizada"
    printf '%s\n' "${actual}"
}

assert_regular_file() {
    local file="$1"
    [[ -f ${file} && ! -L ${file} ]] || die "arquivo regular exigido: ${file}"
}

read_env_value() {
    local key="$1"
    local value
    assert_regular_file "${ENV_FILE}"
    value="$(awk -v key="${key}" '
        $0 ~ "^[[:space:]]*" key "=" {
            sub("^[[:space:]]*" key "=", "")
            value=$0
        }
        END {
            if (value ~ /^\047.*\047$/ || value ~ /^\".*\"$/) {
                value=substr(value, 2, length(value)-2)
            }
            printf "%s", value
        }
    ' "${ENV_FILE}")"
    [[ -n ${value} ]] || return 1
    printf '%s' "${value}"
}

active_release() {
    if [[ -f ${ACTIVE_RELEASE_FILE} && ! -L ${ACTIVE_RELEASE_FILE} ]]; then
        head -n 1 "${ACTIVE_RELEASE_FILE}"
    else
        printf '%s' "unmanaged"
    fi
}

write_active_release() {
    local release="$1"
    local temporary
    install -d -m 0700 "${STATE_ROOT}"
    assert_no_symlink_path "${STATE_ROOT}"
    temporary="$(mktemp "${STATE_ROOT}/current-release.XXXXXX")"
    printf '%s\n' "${release}" >"${temporary}"
    chmod 0600 "${temporary}"
    mv -fT -- "${temporary}" "${ACTIVE_RELEASE_FILE}"
}

json_escape() {
    local value="$1"
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    printf '%s' "${value}"
}

ledger() {
    local action="$1"
    local result="$2"
    local subject="$3"
    local details="${4:-}"
    local line
    install -d -m 0700 "${STATE_ROOT}"
    assert_no_symlink_path "${STATE_ROOT}"
    [[ ! -e ${LEDGER_FILE} || -f ${LEDGER_FILE} && ! -L ${LEDGER_FILE} ]] \
        || die "ledger inseguro"
    printf -v line \
        '{"at":"%s","action":"%s","result":"%s","subject":"%s","details":"%s"}\n' \
        "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" \
        "$(json_escape "${action}")" \
        "$(json_escape "${result}")" \
        "$(json_escape "${subject}")" \
        "$(json_escape "${details}")"
    printf '%s' "${line}" >>"${LEDGER_FILE}"
    chmod 0600 "${LEDGER_FILE}"
}

parse_database_url() {
    local url="$1"
    local address
    [[ ${url} =~ ^jdbc:postgresql://([^/:?#]+)(:([0-9]+))?/([^?]+) ]] \
        || die "DB_URL PostgreSQL nao reconhecida"
    DB_HOST="${BASH_REMATCH[1]}"
    DB_PORT="${BASH_REMATCH[3]:-5432}"
    address="${BASH_REMATCH[4]}"
    DB_NAME="${address%%\?*}"
    [[ ${DB_PORT} =~ ^[0-9]+$ && -n ${DB_NAME} ]] \
        || die "DB_URL PostgreSQL invalida"
}

flyway_versions() {
    local db_url db_user db_password
    db_url="$(read_env_value DB_URL)" || die "DB_URL ausente"
    db_user="$(read_env_value DB_USERNAME)" || die "DB_USERNAME ausente"
    db_password="$(read_env_value DB_PASSWORD)" || die "DB_PASSWORD ausente"
    parse_database_url "${db_url}"
    PGPASSWORD="${db_password}" timeout "${COMMAND_TIMEOUT}" \
        psql -XAt -h "${DB_HOST}" -p "${DB_PORT}" -U "${db_user}" \
        -d "${DB_NAME}" -c \
        "SELECT version FROM flyway_schema_history WHERE success ORDER BY installed_rank;"
}

latest_flyway() {
    local versions
    versions="$(flyway_versions)"
    if [[ -n ${versions} ]]; then
        printf '%s\n' "${versions}" | tail -n 1
    else
        printf '%s\n' "none"
    fi
}

validate_release() {
    local name="$1"
    local release_dir
    local entry
    release_dir="$(validated_child "${RELEASE_ROOT}" "${name}")"
    assert_regular_file "${release_dir}/vitrine7-backend.jar"
    assert_regular_file "${release_dir}/frontend.tar.gz"
    while IFS= read -r entry; do
        case ${entry##*/} in
            vitrine7-backend.jar|frontend.tar.gz|SHA256SUMS) ;;
            *) die "arquivo nao autorizado na release: ${entry}" ;;
        esac
    done < <(find "${release_dir}" -mindepth 1 -maxdepth 1 -type f -print)
    [[ $(find "${release_dir}" -mindepth 1 -maxdepth 1 ! -type f | wc -l) -eq 0 ]] \
        || die "release contem entrada nao regular"
    printf '%s\n' "${release_dir}"
}

validate_frontend_archive() {
    local archive="$1"
    local entry
    local mode
    assert_regular_file "${archive}"
    while IFS= read -r entry; do
        [[ -n ${entry} ]] || continue
        [[ ${entry} != /* && ${entry} != ../* && ${entry} != *"/../"* \
            && ${entry} != */.. ]] || die "caminho inseguro no frontend.tar.gz"
    done < <(timeout "${COMMAND_TIMEOUT}" tar -tzf "${archive}")
    while IFS= read -r mode; do
        case ${mode:0:1} in
            -|d) ;;
            *) die "link ou tipo especial recusado no frontend.tar.gz" ;;
        esac
    done < <(timeout "${COMMAND_TIMEOUT}" tar -tvzf "${archive}" | awk '{print $1}')
    timeout "${COMMAND_TIMEOUT}" tar -tzf "${archive}" \
        | grep -Eq '(^|/)index\.html$' \
        || die "frontend.tar.gz nao contem index.html"
}

release_hashes() {
    local release_dir="$1"
    (
        cd "${release_dir}"
        sha256sum vitrine7-backend.jar frontend.tar.gz
    )
}

write_release_hashes() {
    local release_dir="$1"
    local temporary
    temporary="$(mktemp "${release_dir}/SHA256SUMS.XXXXXX")"
    release_hashes "${release_dir}" >"${temporary}"
    chmod 0600 "${temporary}"
    mv -fT -- "${temporary}" "${release_dir}/SHA256SUMS"
}

validate_release_hashes() {
    local release_dir="$1"
    local actual expected
    if [[ -e ${release_dir}/SHA256SUMS ]]; then
        assert_regular_file "${release_dir}/SHA256SUMS"
        actual="$(cat "${release_dir}/SHA256SUMS")"
        expected="$(release_hashes "${release_dir}")"
        [[ ${actual} == "${expected}" ]] \
            || die "SHA256SUMS da release invalido"
    fi
}

inspect_pending_migrations() {
    local jar="$1"
    local current
    local migration
    local version
    local sql
    current="$(latest_flyway)"
    log "FLYWAY_CURRENT=${current}"
    while IFS= read -r migration; do
        version="${migration##*/V}"
        version="${version%%__*}"
        if [[ ${current} != none ]] \
                && (( 10#${version} <= 10#${current%%.*} )); then
            continue
        fi
        log "MIGRATION_PENDING=${migration##*/}"
        sql="$(unzip -p "${jar}" "${migration}")"
        if grep -Eiq \
            '(^|[[:space:];])(drop[[:space:]]+(table|column|schema|database)|truncate|delete[[:space:]]+from|alter[[:space:]]+table[^;]*(drop|type[[:space:]]))' \
            <<<"${sql}"; then
            die "migration pendente potencialmente destrutiva: ${migration##*/}"
        fi
    done < <(unzip -Z1 "${jar}" \
        | grep -E '^BOOT-INF/classes/db/migration/V[0-9]+__[^/]+\.sql$' \
        | sort -V)
}

preflight_release() {
    local name="$1"
    local release_dir
    require_commands realpath find tar sha256sum unzip psql timeout curl ss \
        systemctl awk grep sort xargs
    release_dir="$(validate_release "${name}")"
    validate_release_hashes "${release_dir}"
    validate_frontend_archive "${release_dir}/frontend.tar.gz"
    timeout "${COMMAND_TIMEOUT}" unzip -tqq \
        "${release_dir}/vitrine7-backend.jar"
    inspect_pending_migrations "${release_dir}/vitrine7-backend.jar"
    release_hashes "${release_dir}"
    log "PREFLIGHT_OK release=${name}"
}

frontend_tree_hash() {
    local directory="$1"
    [[ -d ${directory} && ! -L ${directory} ]] || die "frontend invalido"
    [[ $(find "${directory}" -type l | wc -l) -eq 0 ]] \
        || die "symlink recusado no frontend"
    (
        cd "${directory}"
        find . -type f -print0 | sort -z \
            | xargs -0 -r sha256sum \
            | sha256sum | awk '{print $1}'
    )
}

create_backup() {
    local reason="$1"
    local timestamp backup_name staging final db_url db_user db_password
    local flyway_before
    timestamp="$(date --utc +%Y%m%dT%H%M%SZ)"
    backup_name="${timestamp}-${reason:0:50}"
    staging="${BACKUP_ROOT}/.staging-${backup_name}-$$"
    final="${BACKUP_ROOT}/${backup_name}"
    validate_name "${backup_name}"
    install -d -m 0700 "${BACKUP_ROOT}"
    assert_no_symlink_path "${BACKUP_ROOT}"
    [[ ! -e ${staging} && ! -e ${final} ]] || die "backup ja existe"
    install -d -m 0700 "${staging}"

    assert_regular_file "${BACKEND_JAR}"
    [[ -d ${FRONTEND_DIR} && ! -L ${FRONTEND_DIR} ]] \
        || die "frontend atual invalido"
    [[ $(find "${FRONTEND_DIR}" -type l | wc -l) -eq 0 ]] \
        || die "symlink recusado no frontend atual"
    cp --preserve=mode,timestamps -- "${BACKEND_JAR}" \
        "${staging}/vitrine7-backend.jar"
    timeout "${COMMAND_TIMEOUT}" tar -C "${FRONTEND_DIR}" -czf \
        "${staging}/frontend.tar.gz" .

    db_url="$(read_env_value DB_URL)" || die "DB_URL ausente"
    db_user="$(read_env_value DB_USERNAME)" || die "DB_USERNAME ausente"
    db_password="$(read_env_value DB_PASSWORD)" || die "DB_PASSWORD ausente"
    parse_database_url "${db_url}"
    PGPASSWORD="${db_password}" timeout "${COMMAND_TIMEOUT}" \
        pg_dump -Fc -h "${DB_HOST}" -p "${DB_PORT}" -U "${db_user}" \
        -d "${DB_NAME}" -f "${staging}/database.dump"
    timeout "${COMMAND_TIMEOUT}" pg_restore --list \
        "${staging}/database.dump" >/dev/null

    flyway_before="$(latest_flyway)"
    printf '%s\n' "${flyway_before}" >"${staging}/flyway-before.txt"
    printf 'format=1\ncreated_at=%s\nreason=%s\nactive_release=%s\n' \
        "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" "${reason}" \
        "$(active_release)" >"${staging}/manifest"
    (
        cd "${staging}"
        sha256sum database.dump vitrine7-backend.jar frontend.tar.gz \
            flyway-before.txt manifest >SHA256SUMS
    )
    chmod 0600 "${staging}"/*
    mv -- "${staging}" "${final}"
    printf '%s\n' "${final}"
}

validate_backup() {
    local name="$1"
    local backup_dir
    local actual entry expected hashes
    backup_dir="$(validated_child "${BACKUP_ROOT}" "${name}")"
    for expected in database.dump vitrine7-backend.jar frontend.tar.gz \
            flyway-before.txt manifest SHA256SUMS; do
        assert_regular_file "${backup_dir}/${expected}"
    done
    while IFS= read -r entry; do
        case ${entry##*/} in
            database.dump|vitrine7-backend.jar|frontend.tar.gz|flyway-before.txt|manifest|SHA256SUMS) ;;
            *) die "arquivo nao autorizado no backup: ${entry}" ;;
        esac
    done < <(find "${backup_dir}" -mindepth 1 -maxdepth 1 -type f -print)
    [[ $(find "${backup_dir}" -mindepth 1 -maxdepth 1 ! -type f | wc -l) -eq 0 ]] \
        || die "backup contem entrada nao regular"
    hashes="$(
        cd "${backup_dir}"
        sha256sum database.dump vitrine7-backend.jar frontend.tar.gz \
            flyway-before.txt manifest
    )"
    actual="$(cat "${backup_dir}/SHA256SUMS")"
    [[ ${actual} == "${hashes}" ]] || die "SHA256SUMS do backup invalido"
    timeout "${COMMAND_TIMEOUT}" pg_restore --list \
        "${backup_dir}/database.dump" >/dev/null
    timeout "${COMMAND_TIMEOUT}" unzip -tqq \
        "${backup_dir}/vitrine7-backend.jar"
    validate_frontend_archive "${backup_dir}/frontend.tar.gz"
    printf '%s\n' "${backup_dir}"
}

backend_is_healthy() {
    local _
    for _ in {1..30}; do
        if timeout 5 curl -fsS "${BACKEND_HEALTH}" \
                | grep -q '"status":"UP"'; then
            return 0
        fi
        sleep 2
    done
    return 1
}

site_is_healthy() {
    timeout 20 curl -fsS --max-time 15 "${PUBLIC_SITE}" \
        | grep -Eqi '<(html|!doctype)'
}

ports_are_healthy() {
    local sockets
    sockets="$(ss -ltnH)"
    grep -Eq '[[:space:]]([^[:space:]]*:)?8080[[:space:]]' <<<"${sockets}" \
        && grep -Eq '[[:space:]]([^[:space:]]*:)?8081[[:space:]]' <<<"${sockets}"
}

restart_backend() {
    timeout "${COMMAND_TIMEOUT}" systemctl restart "${SERVICE}"
    backend_is_healthy
}

stage_frontend() {
    local archive="$1"
    local target="$2"
    [[ ! -e ${target} ]] || die "staging frontend ja existe"
    install -d -m 0755 "${target}"
    timeout "${COMMAND_TIMEOUT}" tar -C "${target}" -xzf "${archive}" \
        --no-same-owner --no-same-permissions
    [[ -f ${target}/index.html && ! -L ${target}/index.html ]] \
        || die "index.html ausente no staging"
}

deploy_release() {
    local name="$1"
    local release_dir backup_dir staging_frontend old_frontend new_jar old_jar
    local before after
    require_root
    acquire_lock
    require_commands pg_dump pg_restore
    preflight_release "${name}"
    release_dir="$(validate_release "${name}")"
    write_release_hashes "${release_dir}"
    backup_dir="$(create_backup "deploy-${name}")"
    before="$(cat "${backup_dir}/flyway-before.txt")"
    staging_frontend="/opt/vitrine7/.frontend-stage-${name}-$$"
    old_frontend="/opt/vitrine7/.frontend-previous-${name}-$$"
    new_jar="${BACKEND_JAR}.new.$$"
    old_jar="${BACKEND_JAR}.previous.$$"
    stage_frontend "${release_dir}/frontend.tar.gz" "${staging_frontend}"
    install -m 0644 "${release_dir}/vitrine7-backend.jar" "${new_jar}"
    cp --preserve=mode,timestamps -- "${BACKEND_JAR}" "${old_jar}"
    mv -fT -- "${new_jar}" "${BACKEND_JAR}"

    if ! restart_backend; then
        after="$(latest_flyway)"
        if [[ ${after} == "${before}" ]]; then
            mv -fT -- "${old_jar}" "${BACKEND_JAR}"
            restart_backend || true
            rm -rf -- "${staging_frontend}"
            ledger deploy failed "${name}" "backend health failed; jar restored; backup=${backup_dir##*/}"
            die "backend sem health; JAR anterior restaurado"
        fi
        ledger deploy failed "${name}" "backend health failed after Flyway advanced ${before}->${after}; backup=${backup_dir##*/}"
        die "backend sem health e Flyway avancou; rollback automatico recusado"
    fi
    rm -f -- "${old_jar}"

    mv -- "${FRONTEND_DIR}" "${old_frontend}"
    mv -- "${staging_frontend}" "${FRONTEND_DIR}"
    if ! site_is_healthy; then
        mv -- "${FRONTEND_DIR}" "${staging_frontend}"
        mv -- "${old_frontend}" "${FRONTEND_DIR}"
        rm -rf -- "${staging_frontend}"
        ledger deploy failed "${name}" "public site failed; frontend restored; backup=${backup_dir##*/}"
        die "frontend publico sem health; frontend anterior restaurado"
    fi
    rm -rf -- "${old_frontend}"
    after="$(latest_flyway)"
    write_active_release "${name}"
    ledger deploy ok "${name}" "backup=${backup_dir##*/};flyway=${before}->${after}"
    log "BACKUP=${backup_dir}"
    log "FLYWAY_BEFORE=${before}"
    log "FLYWAY_AFTER=${after}"
    log "DEPLOY_OK release=${name}"
}

rollback_artifacts() {
    local name="$1"
    local source backup_before stage old_frontend new_jar before current
    require_root
    acquire_lock
    require_commands realpath find sha256sum unzip pg_dump pg_restore tar psql \
        curl systemctl timeout awk grep sort xargs
    source="$(validate_backup "${name}")"
    before="$(cat "${source}/flyway-before.txt")"
    current="$(latest_flyway)"
    [[ ${before} == "${current}" ]] || die \
        "Flyway divergiu (${before} != ${current}); rollback de artefatos recusado"
    backup_before="$(create_backup "before-rollback-${name}")"
    stage="/opt/vitrine7/.frontend-rollback-${name}-$$"
    old_frontend="/opt/vitrine7/.frontend-before-rollback-${name}-$$"
    new_jar="${BACKEND_JAR}.rollback.$$"
    stage_frontend "${source}/frontend.tar.gz" "${stage}"
    install -m 0644 "${source}/vitrine7-backend.jar" "${new_jar}"
    mv -fT -- "${new_jar}" "${BACKEND_JAR}"
    mv -- "${FRONTEND_DIR}" "${old_frontend}"
    mv -- "${stage}" "${FRONTEND_DIR}"
    if ! restart_backend || ! site_is_healthy; then
        install -m 0644 "${backup_before}/vitrine7-backend.jar" \
            "${BACKEND_JAR}.recovery.$$"
        mv -fT -- "${BACKEND_JAR}.recovery.$$" "${BACKEND_JAR}"
        mv -- "${FRONTEND_DIR}" "${stage}"
        mv -- "${old_frontend}" "${FRONTEND_DIR}"
        restart_backend || true
        site_is_healthy || true
        rm -rf -- "${stage}"
        ledger rollback-artifacts failed "${name}" \
            "health failed; previous artifacts restored; recovery backup=${backup_before##*/}"
        die "rollback sem health; artefatos anteriores restaurados"
    fi
    rm -rf -- "${old_frontend}"
    write_active_release "rollback-${name}"
    ledger rollback-artifacts ok "${name}" "backup=${backup_before##*/}"
    log "BACKUP_BEFORE_ROLLBACK=${backup_before}"
    log "ROLLBACK_ARTIFACTS_OK backup=${name}"
}

agents_status() {
    local strict="${1:-false}"
    local credential response_file header_file http_code online_count
    require_commands curl timeout grep
    credential="$(read_env_value REPORT_PROTECTED_PASSWORD)" \
        || die "REPORT_PROTECTED_PASSWORD ausente"
    [[ ${credential} != *$'\r'* && ${credential} != *$'\n'* ]] \
        || die "REPORT_PROTECTED_PASSWORD contem caractere de controle"
    response_file="$(mktemp)"
    header_file="$(mktemp)"
    chmod 0600 "${response_file}"
    chmod 0600 "${header_file}"
    printf 'X-Report-Password: %s\n' "${credential}" >"${header_file}"
    http_code="$(timeout 20 curl -sS --max-time 15 -o "${response_file}" \
        -w '%{http_code}' -H "@${header_file}" \
        "${AGENTS_HEALTH}")" || {
        rm -f -- "${response_file}" "${header_file}"
        die "consulta de agentes falhou"
    }
    rm -f -- "${header_file}"
    [[ ${http_code} == 200 ]] || {
        rm -f -- "${response_file}"
        die "consulta de agentes retornou HTTP ${http_code}"
    }
    cat "${response_file}"
    printf '\n'
    if [[ ${strict} == true ]]; then
        online_count="$(grep -o '"status":"ONLINE"' "${response_file}" | wc -l)"
        [[ ${online_count} -eq 2 ]] || {
            rm -f -- "${response_file}"
            die "agents-status estrito exige Printer e PagBank ONLINE"
        }
        log "AGENTS_STATUS_OK"
    fi
    rm -f -- "${response_file}"
}

status_command() {
    require_root
    require_commands systemctl curl ss psql timeout awk grep
    systemctl is-active --quiet "${SERVICE}" || die "servico backend inativo"
    backend_is_healthy || die "backend sem health"
    site_is_healthy || die "site publico sem health"
    ports_are_healthy || die "listeners 8080/8081 incompletos"
    ss -ltn | awk '$4 ~ /:8080$|:8081$/ {print}'
    log "ACTIVE_RELEASE=$(active_release)"
    log "FLYWAY_CURRENT=$(latest_flyway)"
    agents_status false
    log "STATUS_OK"
}

list_releases() {
    local prune="${1:-false}"
    local confirmation="${2:-}"
    local active kept_non_active name path disposition
    local -a names=()
    require_root
    require_commands realpath find sort awk
    assert_no_symlink_path "${RELEASE_ROOT}"
    [[ -d ${RELEASE_ROOT} ]] || die "raiz de releases inexistente"
    active="$(active_release)"
    kept_non_active=0
    while IFS= read -r name; do
        names+=("${name}")
    done < <(find "${RELEASE_ROOT}" -mindepth 1 -maxdepth 1 -type d \
        ! -lname '*' -printf '%T@ %f\n' | sort -rn | awk '{print $2}')
    for name in "${names[@]}"; do
        validate_name "${name}"
        path="$(validated_child "${RELEASE_ROOT}" "${name}")"
        disposition="CANDIDATE"
        if [[ ${name} == "${active}" ]]; then
            disposition="ACTIVE"
        elif (( kept_non_active < 3 )); then
            disposition="KEEP_LAST_3"
            kept_non_active=$((kept_non_active + 1))
        fi
        log "${disposition} ${name}"
        if [[ ${prune} == true && ${disposition} == CANDIDATE ]]; then
            [[ ${confirmation} == DELETE-OLD-RELEASES ]] \
                || die "confirmacao explicita ausente"
            assert_no_symlink_path "${path}"
            rm -rf --one-file-system -- "${path}"
            ledger release-prune ok "${name}" "retention=3;active=${active}"
        fi
    done
}

adopt_current_release() {
    local name="$1"
    local release_dir stage current_backend_hash release_backend_hash
    local current_frontend_hash release_frontend_hash
    require_root
    acquire_lock
    require_commands realpath find tar sha256sum awk sort xargs
    release_dir="$(validate_release "${name}")"
    validate_release_hashes "${release_dir}"
    validate_frontend_archive "${release_dir}/frontend.tar.gz"
    current_backend_hash="$(sha256sum "${BACKEND_JAR}" | awk '{print $1}')"
    release_backend_hash="$(sha256sum "${release_dir}/vitrine7-backend.jar" | awk '{print $1}')"
    [[ ${current_backend_hash} == "${release_backend_hash}" ]] \
        || die "JAR atual nao corresponde a release"
    stage="/opt/vitrine7/.adopt-${name}-$$"
    stage_frontend "${release_dir}/frontend.tar.gz" "${stage}"
    current_frontend_hash="$(frontend_tree_hash "${FRONTEND_DIR}")"
    release_frontend_hash="$(frontend_tree_hash "${stage}")"
    rm -rf -- "${stage}"
    [[ ${current_frontend_hash} == "${release_frontend_hash}" ]] \
        || die "frontend atual nao corresponde a release"
    write_release_hashes "${release_dir}"
    write_active_release "${name}"
    ledger adopt-current-release ok "${name}" "artifacts matched"
    log "ADOPT_CURRENT_RELEASE_OK release=${name}"
}

rotate_report_credential() {
    local credential temporary backup_file header_file mode owner group
    local http_code
    require_root
    acquire_lock
    require_commands openssl awk systemctl curl stat timeout grep
    assert_no_symlink_path "${ENV_FILE}"
    assert_regular_file "${ENV_FILE}"
    credential="$(openssl rand -base64 36 | tr -d '\n=/+')"
    [[ ${#credential} -ge 32 ]] || die "falha ao gerar credencial"
    temporary="$(mktemp "${ENV_FILE}.XXXXXX")"
    backup_file="${STATE_ROOT}/application.env.before-report-rotation"
    install -d -m 0700 "${STATE_ROOT}"
    assert_no_symlink_path "${STATE_ROOT}"
    cp --preserve=mode,ownership,timestamps -- "${ENV_FILE}" "${backup_file}"
    chmod 0600 "${backup_file}"
    ROTATED_REPORT_CREDENTIAL="${credential}" awk '
        BEGIN { replaced=0 }
        /^[[:space:]]*REPORT_PROTECTED_PASSWORD=/ {
            print "REPORT_PROTECTED_PASSWORD=" ENVIRON["ROTATED_REPORT_CREDENTIAL"]
            replaced=1
            next
        }
        { print }
        END {
            if (!replaced) {
                print "REPORT_PROTECTED_PASSWORD=" ENVIRON["ROTATED_REPORT_CREDENTIAL"]
            }
        }
    ' "${ENV_FILE}" >"${temporary}"
    mode="$(stat -c '%a' "${ENV_FILE}")"
    owner="$(stat -c '%u' "${ENV_FILE}")"
    group="$(stat -c '%g' "${ENV_FILE}")"
    chmod "${mode}" "${temporary}"
    chown "${owner}:${group}" "${temporary}"
    mv -fT -- "${temporary}" "${ENV_FILE}"
    if ! restart_backend; then
        cp --preserve=mode,ownership,timestamps -- "${backup_file}" "${ENV_FILE}"
        restart_backend || true
        ledger rotate-report-credential failed report "backend health failed; previous environment restored"
        die "rotacao falhou; arquivo anterior restaurado"
    fi
    header_file="$(mktemp)"
    chmod 0600 "${header_file}"
    printf 'X-Report-Password: %s\n' "${credential}" >"${header_file}"
    http_code="$(timeout 20 curl -sS -o /dev/null -w '%{http_code}' \
        -H "@${header_file}" "${AGENTS_HEALTH}")"
    rm -f -- "${header_file}"
    if [[ ${http_code} != 200 ]]; then
        cp --preserve=mode,ownership,timestamps -- "${backup_file}" "${ENV_FILE}"
        restart_backend || true
        ledger rotate-report-credential failed report "credential validation failed; previous environment restored"
        die "nova credencial nao foi validada; arquivo anterior restaurado"
    fi
    rm -f -- "${backup_file}"
    ledger rotate-report-credential ok report "credential replaced and backend healthy"
    log "ROTATE_REPORT_CREDENTIAL_OK"
}

main() {
    local command="${1:-}"
    case ${command} in
        status)
            [[ $# -eq 1 ]] || die "argumentos invalidos"
            status_command
            ;;
        preflight)
            [[ $# -eq 2 ]] || die "informe a release"
            require_root
            preflight_release "$2"
            ;;
        deploy)
            [[ $# -eq 2 ]] || die "informe a release"
            deploy_release "$2"
            ;;
        rollback-artifacts)
            [[ $# -eq 2 ]] || die "informe o backup"
            rollback_artifacts "$2"
            ;;
        releases)
            if [[ $# -eq 1 ]]; then
                list_releases false
            elif [[ $# -eq 3 && $2 == --prune \
                    && $3 == --confirm=DELETE-OLD-RELEASES ]]; then
                acquire_lock
                list_releases true DELETE-OLD-RELEASES
            else
                die "argumentos invalidos para releases"
            fi
            ;;
        adopt-current-release)
            [[ $# -eq 2 ]] || die "informe a release"
            adopt_current_release "$2"
            ;;
        rotate-report-credential)
            [[ $# -eq 1 ]] || die "argumentos invalidos"
            rotate_report_credential
            ;;
        agents-status)
            require_root
            if [[ $# -eq 1 ]]; then
                agents_status false
            elif [[ $# -eq 2 && $2 == --strict ]]; then
                agents_status true
            else
                die "argumentos invalidos para agents-status"
            fi
            ;;
        help|-h|--help)
            usage
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"
